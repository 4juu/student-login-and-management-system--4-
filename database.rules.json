{
  "rules": {
    // ══════════════════════════════════════════════════════════
    // 👥 المستخدمون
    // ══════════════════════════════════════════════════════════
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || (root.child('users').child(auth.uid).child('role').val() == 'college_admin' && root.child('users').child($uid).child('role').val() == 'teacher'))"
      }
    },

    // ══════════════════════════════════════════════════════════
    // 🏛️ أدمنية الكليات
    // ══════════════════════════════════════════════════════════
    "collegeAdmins": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$uid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    },

    // ══════════════════════════════════════════════════════════
    // 🔐 حسابات التدريسيين
    // ══════════════════════════════════════════════════════════
    "teacherAccounts": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'college_admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'college_admin')"
      }
    },

    // ══════════════════════════════════════════════════════════
    // ⚙️ إعدادات النظام
    // ══════════════════════════════════════════════════════════
    "system": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    // ══════════════════════════════════════════════════════════
    // 🗑️ الحسابات المحذوفة
    // ══════════════════════════════════════════════════════════
    "deletedAccounts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    // ══════════════════════════════════════════════════════════
    // 🔗 نظام التسجيل الذاتي — الروابط
    // ══════════════════════════════════════════════════════════
    "registrationSystem": {
      "links": {
        ".read": true,
        "$token": {
          ".read": true,
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'college_admin')",
          // ✅ يسمح للطالب بتعليم الرابط كمستخدم بعد إتمام التسجيل الذاتي
          // (الكتابة على قيمة "used" فقط بقيمة true — لا يمكن حذفها أو تغييرها للطالب)
          "used": {
            ".write": "newData.val() === true || auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'college_admin')"
          }
        }
      },

      // ══════════════════════════════════════════════════════
      // 📥 نظام التسجيل الذاتي — الطلبات المعلقة
      // ══════════════════════════════════════════════════════
      "pending": {
        "$adminUid": {
          ".read": "auth != null && (auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          "$requestId": {
            ".write": "(!data.exists() && newData.exists()) || auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin'"
          }
        }
      }
    },

    // ══════════════════════════════════════════════════════════
    // 🏛️ الكليات والمراحل
    // ══════════════════════════════════════════════════════════
    "colleges": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'college_admin')"
    },

    "stages": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'college_admin')"
    },

    // ══════════════════════════════════════════════════════════
    // 📚 البيانات الأكاديمية
    // ══════════════════════════════════════════════════════════
    "academicYears": {
      "$year": {

        "userData": {
          "$adminUid": {
            ".read": "auth != null && (auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('adminId').val() == $adminUid)",
            ".write": "auth != null && (auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('adminId').val() == $adminUid)",

            "colleges": {
              ".read": true,
              ".write": "auth != null && (auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
            },

            "stages": {
              ".read": true,
              ".write": "auth != null && (auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
            },

            "stageData": {
              "$stageId": {
                "students": {
                  ".read": true,
                  // ⚠️ مفتوح للكتابة لأن auto-approve يحتاجها بدون auth
                  // مستقبلاً: استخدم Cloud Function لتحسين الأمان
                  ".write": true
                },

                "teacherRecords": {
                  "$teacherId": {
                    ".read": "auth != null && (auth.uid == $teacherId || auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('adminId').val() == $adminUid)",
                    ".write": "auth != null && (auth.uid == $teacherId || auth.uid == $adminUid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('adminId').val() == $adminUid)"
                  }
                }
              }
            }
          }
        }
      }
    },

    // ══════════════════════════════════════════════════════════
    // ❌ رفض أي مسارات غير معرفة
    // ══════════════════════════════════════════════════════════
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
